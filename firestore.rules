rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LIVE POLICY: Chatre data is Admin-SDK only (Vercel API).
    // Publish these rules in Firebase Console → Firestore → Rules.
    // Clients using the web apiKey must NOT read/write this tree.
    match /sites/chatre/{document=**} {
      allow read, write: if false;
    }

    // Deny everything else by default in this ruleset scope.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
