# Chatre API — copy to .env.local for `vercel dev` / selfhost

# Shared secret for companion / service scripts (Bearer or x-chatre-key).
# User accounts use Firebase Auth ID tokens instead.
CHATRE_API_TOKEN=change-me

# Encrypt BYOK provider keys at rest (32-byte hex OR any passphrase)
BYOK_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Firestore via Firebase Admin
# Paste the full service-account JSON as a single line, or use a file path.
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_PROJECT_ID=re-el-eed0d
SITE_ID=chatre

# Cloudflare Workers AI chat endpoint (your deployed chatre1 worker)
CHATRE_WORKER_URL=https://YOUR_WORKER.workers.dev
# Optional: same secret the Worker expects as CHATRE_SECRET
CHATRE_WORKER_SECRET=

# Optional OpenRouter attribution
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=Chatre

# Optional: enable @vercel/sandbox for isolated exec
# USE_VERCEL_SANDBOX=1
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Local selfhost port
PORT=8080

# Role-based model routing (optional — falls back to session model)
# CHATRE_MODEL_STRATEGY=
# CHATRE_MODEL_EXECUTE=
# CHATRE_MODEL_MONITOR=
# CHATRE_MODEL_VERIFY=
# CHATRE_MODEL_RESEARCH=
# CHATRE_RUN_TOKEN_BUDGET=180000
